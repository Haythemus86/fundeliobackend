generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum FundraiserVisibility {
  PUBLIC
  PRIVATE
}

enum FundraiserStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED
  ARCHIVED
}

enum ContributionStatus {
  PENDING
  CONFIRMED
  FAILED
  CANCELLED
}

model User {
  id              String         @id @default(uuid()) @db.Uuid
  email           String         @unique @db.VarChar(255)
  passwordHash    String         @db.VarChar(255)
  firstName       String         @db.VarChar(100)
  lastName        String         @db.VarChar(100)
  phone           String?        @db.VarChar(30)
  role            UserRole       @default(USER)
  emailVerifiedAt DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  fundraisers     Fundraiser[]   @relation("FundraiserCreator")
  contributions   Contribution[] @relation("UserContributions")
  activities      ActivityLog[]  @relation("ActivityActor")

  @@index([createdAt])
}

model Category {
  id          Int          @id @default(autoincrement())
  name        String       @unique @db.VarChar(100)
  slug        String       @unique @db.VarChar(120)
  groupName   String       @db.VarChar(50)
  createdAt   DateTime     @default(now())

  fundraisers Fundraiser[]

  @@index([groupName])
}

model Fundraiser {
  id                 String               @id @default(uuid()) @db.Uuid
  creatorId          String               @db.Uuid
  categoryId         Int
  title              String               @db.VarChar(80)
  description        String               @db.Text
  hasGoal            Boolean              @default(true)
  goalAmount         Decimal?             @db.Decimal(12, 2)
  visibility         FundraiserVisibility  @default(PUBLIC)
  hideContributions  Boolean              @default(false)
  endDate            DateTime?
  photoUrl           String?              @db.VarChar(500)
  emoji              String?              @db.VarChar(20)
  color              String?              @db.VarChar(30)
  shareToken         String               @unique @default(uuid()) @db.Uuid
  status             FundraiserStatus      @default(ACTIVE)
  deletedAt          DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  creator            User                 @relation("FundraiserCreator", fields: [creatorId], references: [id], onDelete: Restrict)
  category           Category             @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  contributions      Contribution[]
  activities         ActivityLog[]

  @@index([creatorId, status])
  @@index([categoryId, status])
  @@index([visibility, status, createdAt])
}

model Contribution {
  id             String             @id @default(uuid()) @db.Uuid
  fundraiserId   String             @db.Uuid
  contributorId  String?            @db.Uuid
  guestName      String?            @db.VarChar(150)
  guestEmail     String?            @db.VarChar(255)
  amount         Decimal            @db.Decimal(12, 2)
  message        String?            @db.Text
  status         ContributionStatus @default(PENDING)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  fundraiser     Fundraiser         @relation(fields: [fundraiserId], references: [id], onDelete: Restrict)
  contributor    User?              @relation("UserContributions", fields: [contributorId], references: [id], onDelete: SetNull)

  @@index([fundraiserId, status, createdAt])
  @@index([contributorId, createdAt])
}

model ActivityLog {
  id            String      @id @default(uuid()) @db.Uuid
  fundraiserId  String      @db.Uuid
  actorId       String?     @db.Uuid
  type          String      @db.VarChar(60)
  metadata      Json?
  createdAt     DateTime    @default(now())

  fundraiser    Fundraiser  @relation(fields: [fundraiserId], references: [id], onDelete: Cascade)
  actor         User?       @relation("ActivityActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([fundraiserId, createdAt])
  @@index([actorId, createdAt])
}